# Minimum for local dev - see README.md for the full list, app/config.py
# for every var this app actually reads.
API_KEY=
HF_TOKEN=

# Every <NAME>_INFERENCE_URL var registers a model selectable via
# /api/analyze?model=<name> - add a new model by adding a var, no code
# change. HF_INFERENCE_URL is the legacy var for DEFAULT_MODEL's URL.
LLAMA_INFERENCE_URL=
APERTUS_INFERENCE_URL=
# Which registered model answers when ?model= is omitted.
DEFAULT_MODEL=llama

# Neon Postgres connection string for the research-scan persistence layer
# (app/db, app/services/scan_persistence.py, app/services/scheduler.py).
# Get this from the Neon dashboard - it already includes ?sslmode=require.
DATABASE_CONNECTION_STRING=
