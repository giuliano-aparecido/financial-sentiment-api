# Minimum for local dev - see README.md for the full list, app/config.py
# for every var this app actually reads.
API_KEY=
HF_TOKEN=

# Every <NAME>_INFERENCE_URL var registers a model selectable via
# /api/analyze?model=<name> - add a new model by adding a var, no code
# change. DEFAULT_MODEL must have one.
LLAMA_INFERENCE_URL=
APERTUS_INFERENCE_URL=
# Which registered model answers when ?model= is omitted.
DEFAULT_MODEL=llama

# Optional: Gemini picks the news headline fed to the model; without it the
# regex filters in app/services/news.py do. The model must accept a zero
# thinking budget (a flash model, not pro).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
